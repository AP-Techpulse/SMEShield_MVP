# SMEShield Nigeria — Environment Configuration Template
# Duplicate this file to .env.local and populate with your verified project keys.
# NEVER commit .env or .env.local containing live production credentials.

# Supabase Public Configuration (Client & Browser Accessible)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# Supabase Server Service Role (RESTRICTED: Never expose to browser or client bundle)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# Production Site URL (For OAuth callback redirects and email verification links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brevo (Sendinblue) Transactional Email Integration (Optional for email team invites)
BREVO_API_KEY=xkeysib-...your-brevo-api-key
BREVO_SENDER_EMAIL=hello@smeshield.ng
BREVO_SENDER_NAME="SMEShield Nigeria"
